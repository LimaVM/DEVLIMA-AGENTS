# Copie para .env e use scripts/init_env.py para gerar secrets.
COMPOSE_PROJECT_NAME=devlima-agent
POSTGRES_DB=devlima_agent
POSTGRES_USER=agent
POSTGRES_PASSWORD=
JWT_SECRET=
JWT_ISSUER=devlima-agent
JWT_AUDIENCE=devlima-android
JWT_TTL_MINUTES=30
DEFAULT_TIMEZONE=America/Sao_Paulo
ENABLE_API_DOCS=false
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
# Defaults privados. Para HTTPS público, configure domínio/DNS e portas 80/443.
AGENT_DOMAIN=localhost
CADDY_CONFIG=Caddyfile.private
CADDY_BIND=127.0.0.1
HTTP_PORT=8080
HTTPS_PORT=8443
# LLM primária pela rede privada (ex.: http://100.x.x.x:8080/v1).
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT=30
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_TIMEOUT=30
LLM_HEALTH_TIMEOUT=5
ALLOW_CLOUD_FALLBACK=true
CONTEXT_RECENT_MESSAGES=8
CONTEXT_MAX_CHARS=12000
SUMMARY_TRIGGER_MESSAGES=16
# Reservados para Fase 5.
VM_MANAGER_BASE_URL=
VM_MANAGER_TOKEN=
MAX_WORKERS=2
MAX_TOTAL_VCPU=4
MAX_TOTAL_RAM_MB=8192
HOST_RAM_RESERVE_MB=4096

SCHEDULER_POLL_SECONDS=5
